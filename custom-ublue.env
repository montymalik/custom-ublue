# Parameters for the image build. Read by the Justfile (set dotenv-load) and
# by the GitHub Actions workflows through `just`.

# output image name, same as the GitHub repository name
IMAGE_NAME=custom-ublue

# GitHub user/organisation that owns the repository and the GHCR package
REPO_ORGANIZATION="montymalik"

IMAGE_DESC="Custom Bluefin DX - Niri Edition: Bluefin DX with the niri compositor, DankMaterialShell and a curated toolset"
IMAGE_KEYWORDS="bootc,ublue,universal-blue,bluefin,niri"

# Shown on https://artifacthub.io/ if the image is ever listed there
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
